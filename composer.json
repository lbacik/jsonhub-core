{
  "name": "jsonhub/core",
  "description": "JsonHub Core (https://jsonhub.cloud)",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "JsonHub\\": "src/JsonHub/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "spec\\JsonHub\\": "spec/"
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*",
    "lbacik/value-object": "^1.0"
  },
  "require-dev": {
    "phpspec/phpspec": "^8.3",
    "friends-of-phpspec/phpspec-code-coverage": "^7.0",
    "squizlabs/php_codesniffer": "^4.0",
    "infection/infection": "^0.35.6",
    "infection/phpspec-adapter": "0.3.1"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    },
    "platform": {
      "php": "8.4"
    }
  },
  "scripts": {
    "test": "phpspec run --no-interaction --format=progress",
    "mutation": [
      "Composer\\Config::disableProcessTimeout",
      "@test",
      "@mutation:run"
    ],
    "mutation:run": [
      "Composer\\Config::disableProcessTimeout",
      "@php -d memory_limit=512M vendor/bin/infection --coverage=coverage --no-progress"
    ]
  }
}
